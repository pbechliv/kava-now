{
  "name": "kava-now",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "wt": "bash tools/git/wt/wt.sh",
    "dev": "pnpm services:up && pnpm --parallel --filter @kava-now/api --filter @kava-now/web dev",
    "dev:api": "pnpm services:up && pnpm --filter @kava-now/api dev",
    "dev:web": "pnpm --filter @kava-now/web dev",
    "build": "pnpm --filter @kava-now/shared --if-present build && pnpm --parallel --filter @kava-now/api --filter @kava-now/web build",
    "lint": "vp lint packages/",
    "fmt": "vp fmt --write packages/",
    "fmt:check": "vp fmt --check packages/",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "services:up": "bash scripts/dev-services.sh",
    "services:down": "docker compose -f docker-compose.dev.yml down",
    "db:migrate": "pnpm services:up && pnpm --filter @kava-now/api db:migrate",
    "db:seed": "pnpm services:up && pnpm --filter @kava-now/api db:seed",
    "db:generate": "pnpm --filter @kava-now/api db:generate",
    "db:reset": "pnpm services:up && pnpm --filter @kava-now/api db:reset",
    "db:reseed": "pnpm db:reset && pnpm db:migrate && pnpm db:seed"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
}
